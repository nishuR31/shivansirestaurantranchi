generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prismaAdmin"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  SUPERADMIN
}

model Admin {
  id       String  @id @default(uuid())
  name     String
  email    String  @unique
  phone    String?
  password String  @map("hashed_password")
  role     Role

  avatarUrl String?

  isActive     Boolean  @default(true)
  lastLogin    DateTime @default(now())
  refreshToken String?

  totpSecret    String?
  isTotpEnabled Boolean @default(false)

  currentChallenge String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  auditLog AuditLog[]
  passkeys Passkey[]

  @@index([email])
  @@index([role])
  @@map("admins")
}

model Passkey {
  id             String @id @default(uuid())
  credentialID   Bytes
  credentialPublicKey Bytes
  counter        BigInt
  transports     String[]
  
  adminId        String
  admin          Admin   @relation(fields: [adminId], references: [id], onDelete: Cascade)
  
  createdAt      DateTime @default(now())

  @@index([adminId])
  @@index([credentialID])
  @@map("passkeys")
}

model AuditLog {
  id       String @id @default(uuid())
  action   String
  entity   String
  entityId String
  details  Json?

  createdAt DateTime @default(now())

  adminId String
  admin   Admin   @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([entity])
  @@index([createdAt])
  @@map("audit_logs")
}

model RestaurantSettings {
  id              String  @id @default(uuid())
  name            String
  tagline         String?
  logo_url        String?
  banner_url      String?
  address         String?
  phone           String?
  gst_number      String?
  opening_time    String?
  closing_time    String?
  upi_id          String?
  tax_percent     Decimal   @default(5)
  packing_charge  Decimal   @default(0)
  delivery_charge Decimal   @default(0)
  currency        String  @default("INR")
  theme           String  @default("default")
  is_suspended     Boolean @default(false)
  shutdown_code    Int?
  shutdown_message String?

  @@map("restaurant_settings")
}

model AppConfig {
  id                       String   @id @default(uuid())
  owner_email              String?
  whatsapp_token           String?
  whatsapp_phone_number_id String?
  updated_at               DateTime @updatedAt

  @@map("app_config")
}

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prismaApp"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
  SUPERADMIN
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  PREPARED
  SERVED
  COMPLETED
  CANCELLED
}

model User {
  id       String  @id @default(uuid())
  name     String
  email    String  @unique
  phone    String? @unique
  password String  @map("hashed_password")
  role     Role

  avatarUrl String?

  isActive     Boolean  @default(true)
  lastLogin    DateTime @default(now())
  refreshToken String?

  totpSecret    String?
  isTotpEnabled Boolean @default(false)

  currentChallenge String?

  passkeys Passkey[]

  birthday       DateTime?
  visits         Int       @default(0)
  reward_points  Int       @default(0)
  total_spend    Decimal     @default(0)
  favourite_item String?
  saved_address  String?
  last_visit     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders Order[]
  action_requests AdminActionRequest[] @relation("Requester")
  action_votes    AdminActionVote[]    @relation("Voter")

  @@index([email])
  @@index([role])
  @@map("users")
}

model Category {
  id          String  @id @default(uuid())
  name        String
  slug        String  @unique
  description String?
  image_url   String?
  sort_order  Int     @default(0)
  is_active   Boolean @default(true)

  products Product[]

  @@map("categories")
}

model Product {
  id              String  @id @default(uuid())
  category_id     String?
  category        Category? @relation(fields: [category_id], references: [id], onDelete: SetNull)
  name            String
  description     String?
  image_url       String?
  price           Decimal
  offer_price     Decimal?
  rating          Decimal   @default(0)
  review_count    Int     @default(0)
  prep_time_mins  Int     @default(15)
  is_available    Boolean @default(true)
  is_spicy        Boolean @default(false)
  calories        Int     @default(0)
  is_special      Boolean @default(false)
  is_popular      Boolean @default(false)
  is_recommended  Boolean @default(false)
  sold_by_weight  Boolean @default(false)
  price_per_kg    Decimal?
  sort_order      Int     @default(0)

  orderItems OrderItem[]

  @@index([category_id, is_available])
  @@index([is_available, sort_order])
  @@map("products")
}

model Offer {
  id               String    @id @default(uuid())
  title            String
  description      String?
  banner_url       String?
  discount_percent Decimal
  coupon_code      String?   @unique
  category_ids     String[]
  product_ids      String[]
  starts_at        DateTime?
  ends_at          DateTime?
  is_active        Boolean   @default(true)

  @@map("offers")
}

model Discount {
  id               String    @id @default(uuid())
  name             String
  type             String
  coupon_code      String?   @unique
  value            Decimal
  min_order_amount Decimal
  max_discount     Decimal?
  category_ids     String[]
  product_ids      String[]
  starts_at        DateTime?
  ends_at          DateTime?
  start_hour       Int?
  end_hour         Int?
  is_active        Boolean   @default(true)
  usage_count      Int       @default(0)

  @@map("discounts")
}

model LoyaltyRule {
  id               String  @id @default(uuid())
  visits_required  Int
  discount_percent Decimal
  reward_points    Int
  expiry_days      Int
  is_active        Boolean @default(true)

  @@map("loyalty_rules")
}

model InventoryItem {
  id                  String    @id @default(uuid())
  name                String
  unit                String
  quantity            Decimal
  low_stock_threshold Decimal
  cost_per_unit       Decimal
  expiry_date         DateTime?

  @@map("inventory_items")
}

model RestaurantTable {
  id           String  @id @default(uuid())
  table_number Int     @unique
  seats        Int
  is_active    Boolean @default(true)

  @@map("restaurant_tables")
}



model Order {
  id              String  @id @default(uuid())
  order_number    String  @unique
  bill_id         String? @unique
  idempotency_key String? @unique
  request_hash    String? @unique
  session_token   String
  table_number    Int?
  user_id         String?
  user            User? @relation(fields: [user_id], references: [id], onDelete: SetNull)
  customer_name   String?
  customer_phone  String?
  status          OrderStatus @default(PENDING)
  payment_method  String
  payment_status  String
  subtotal        Decimal
  discount        Decimal
  discount_label  String?
  tax             Decimal
  packing_charge  Decimal
  delivery_charge Decimal
  total           Decimal
  notes           String?
  created_at      DateTime @default(now())

  order_items OrderItem[]

  @@index([user_id, created_at])
  @@index([customer_phone, created_at])
  @@index([status, created_at])
  @@index([payment_status, created_at])
  @@map("orders")
}

model OrderItem {
  id           String  @id @default(uuid())
  order_id     String
  order        Order   @relation(fields: [order_id], references: [id], onDelete: Cascade)
  product_id   String?
  product      Product? @relation(fields: [product_id], references: [id], onDelete: SetNull)
  name         String
  unit_price   Decimal
  quantity     Decimal
  weight_label String?
  instructions String?
  line_total   Decimal

  @@index([order_id])
  @@index([product_id])
  @@map("order_items")
}

model Review {
  id            String   @id @default(uuid())
  product_id    String?
  customer_name String
  rating        Decimal
  comment       String?
  is_published  Boolean  @default(false)
  created_at    DateTime @default(now())

  @@map("reviews")
}

model Rating {
  id         String   @id @default(cuid())
  orderId    String
  menuItemId String
  userId     String?  // nullable for guest orders
  phone      String   // used to associate guest ratings
  stars      Int      // 1–5
  comment    String?
  createdAt  DateTime @default(now())

  @@unique([orderId, menuItemId, phone])
  @@index([menuItemId])
  @@map("ratings")
}

model AppNotification {
  id         String   @id @default(uuid())
  type       String
  title      String
  body       String
  is_read    Boolean  @default(false)
  created_at DateTime @default(now())

  @@map("app_notifications")
}

model PhoneVerification {
  id         String   @id @default(uuid())
  phone      String
  code_hash  String
  attempts   Int      @default(0)
  used       Boolean  @default(false)
  expires_at DateTime
  created_at DateTime @default(now())

  @@index([phone, used, expires_at])
  @@index([phone])
  @@map("phone_verifications")
}

model AdminActionRequest {
  id              String   @id @default(uuid())
  requester_id    String
  action_type     String
  target_id       String?
  payload         Json?
  status          String   @default("PENDING") // PENDING, APPROVED, REJECTED, EXECUTED, TIME_LOCKED
  approvals       Int      @default(0)
  required_approvals Int   @default(1)
  created_at      DateTime @default(now())
  expires_at      DateTime

  requester       User     @relation("Requester", fields: [requester_id], references: [id])
  votes           AdminActionVote[]
}

model AdminActionVote {
  id              String   @id @default(uuid())
  request_id      String
  voter_id        String
  vote            String   // "APPROVE" or "REJECT"
  created_at      DateTime @default(now())

  request         AdminActionRequest @relation(fields: [request_id], references: [id], onDelete: Cascade)
  voter           User               @relation("Voter", fields: [voter_id], references: [id])

  @@unique([request_id, voter_id])
}

model Passkey {
  id                  String   @id @default(uuid())
  credentialID        Bytes
  credentialPublicKey Bytes
  counter             BigInt
  transports          String[]
  
  userId              String
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  createdAt           DateTime @default(now())

  @@index([userId])
  @@index([credentialID])
  @@map("user_passkeys")
}
