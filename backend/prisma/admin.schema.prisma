generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prismaAdmin"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("ADMIN_DATABASE_URL")
  directUrl = env("ADMIN_DIRECT_URL")
}

enum Role {
  ADMIN
  SUPERADMIN
}

model Admin {
  id       String  @id @default(uuid())
  name     String
  email    String  @unique
  phone    String?
  password String  @map("hashed_password")
  role     Role

  avatarUrl String?

  isActive     Boolean  @default(true)
  lastLogin    DateTime @default(now())
  refreshToken String?

  totpSecret    String?
  isTotpEnabled Boolean @default(false)

  currentChallenge String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  auditLog        AuditLog[]
  passkeys        Passkey[]
  action_requests AdminActionRequest[] @relation("Requester")
  action_votes    AdminActionVote[]    @relation("Voter")

  @@index([email])
  @@index([role])
  @@map("admins")
}

model Passkey {
  id             String @id @default(uuid())
  credentialID   Bytes
  credentialPublicKey Bytes
  counter        BigInt
  transports     String[]
  
  adminId        String
  admin          Admin   @relation(fields: [adminId], references: [id], onDelete: Cascade)
  
  createdAt      DateTime @default(now())

  @@index([adminId])
  @@index([credentialID])
  @@map("passkeys")
}

model AuditLog {
  id       String @id @default(uuid())
  action   String
  entity   String
  entityId String
  details  Json?

  createdAt DateTime @default(now())

  adminId String
  admin   Admin   @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([entity])
  @@index([createdAt])
  @@map("audit_logs")
}

model RestaurantSettings {
  id              String  @id @default(uuid())
  name            String
  tagline         String?
  logo_url        String?
  banner_url      String?
  address         String?
  phone           String?
  gst_number      String?
  opening_time    String?
  closing_time    String?
  upi_id          String?
  tax_percent     Decimal   @default(5)
  packing_charge  Decimal   @default(0)
  delivery_charge Decimal   @default(0)
  currency        String  @default("INR")
  theme           String  @default("default")
  is_suspended     Boolean @default(false)
  shutdown_code    Int?
  shutdown_message String?
  lockdown_password String?

  @@map("restaurant_settings")
}

model AdminActionRequest {
  id              String   @id @default(uuid())
  requester_id    String
  action_type     String
  target_id       String?
  payload         Json?
  status          String   @default("PENDING") // PENDING, APPROVED, REJECTED, EXECUTED, TIME_LOCKED
  approvals       Int      @default(0)
  required_approvals Int   @default(1)
  created_at      DateTime @default(now())
  expires_at      DateTime

  requester       Admin    @relation("Requester", fields: [requester_id], references: [id])
  votes           AdminActionVote[]

  @@map("admin_action_requests")
}

model AdminActionVote {
  id              String   @id @default(uuid())
  request_id      String
  voter_id        String
  vote            String   // "APPROVE" or "REJECT"
  created_at      DateTime @default(now())

  request         AdminActionRequest @relation(fields: [request_id], references: [id], onDelete: Cascade)
  voter           Admin              @relation("Voter", fields: [voter_id], references: [id])

  @@unique([request_id, voter_id])
  @@map("admin_action_votes")
}

model AppConfig {
  id                       String   @id @default(uuid())
  owner_email              String?
  whatsapp_token           String?
  whatsapp_phone_number_id String?
  updated_at               DateTime @updatedAt

  @@map("app_config")
}
