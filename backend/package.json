{
  "name": "authservice",
  "version": "1.0.0",
  "main": "src/index.ts",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "format": "bun prettier --write .",
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "db:gen": "bunx prisma generate --schema=prisma/admin.schema.prisma && bunx prisma generate --schema=prisma/app.schema.prisma && bunx prisma generate --schema=prisma/audit.schema.prisma",
    "db:push:admin": "bunx prisma db push --schema=prisma/admin.schema.prisma",
    "db:push:app": "bunx prisma db push --schema=prisma/app.schema.prisma",
    "db:push:audit": "bunx prisma db push --schema=prisma/audit.schema.prisma",
    "build": "tsc",
    "db:push": "bun run db:push:app && bun run db:push:admin && bun run db:push:audit",
    "db:seed": "bun scripts/seedData.ts"
  },
  "keywords": [],
